{
  "name": "ledgerpro",
  "productName": "LedgerPro",
  "version": "1.6.0",
  "description": "A simple, elegant desktop ledger app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dev:real": "LEDGERPRO_DEV=1 electron .",
    "seed:regen": "ELECTRON_RUN_AS_NODE=1 electron scripts/export-real-seed.js",
    "prestart": "npm run check:native",
    "predev": "npm run check:native",
    "check:native": "electron scripts/check-native.js",
    "dist": "electron-builder --mac --publish never",
    "dist:mac": "electron-builder install-app-deps && electron-builder --mac --publish never",
    "dist:win": "electron-builder install-app-deps && electron-builder --win --publish never",
    "smoke": "LEDGERPRO_SMOKE=1 electron .",
    "lint": "eslint db.js preload.js main.js js/*.js scripts/*.js",
    "lint:fix": "eslint db.js preload.js main.js js/*.js scripts/*.js --fix",
    "format": "prettier --write db.js preload.js main.js js/*.js scripts/*.js css/modern.css index.html",
    "format:check": "prettier --check db.js preload.js main.js js/*.js scripts/*.js css/modern.css index.html",
    "test": "node --test \"test/**/*.test.js\"",
    "audit:dom": "node scripts/test-dom-audit.js",
    "test:persistence": "electron scripts/test-persistence.js",
    "test:period": "electron scripts/test-period.js",
    "release": "bash scripts/release.sh",
    "rebuild:electron": "cd node_modules/better-sqlite3 && ../../node_modules/.bin/node-gyp rebuild --release --target=33.4.11 --arch=arm64 --runtime=electron --dist-url=https://electronjs.org/headers"
  },
  "build": {
    "appId": "com.ledgerpro.desktop",
    "productName": "LedgerPro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist",
      "!build/**",
      "!scripts/**",
      "!diag*.tmp.js",
      "!*.tmp.js",
      "!LOGO.png"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.finance",
      "icon": "icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
